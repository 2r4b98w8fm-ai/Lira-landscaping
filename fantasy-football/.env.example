# Postgres connection string (Neon, Supabase, or local). Required.
DATABASE_URL="postgres://user:password@localhost:5432/gridiron_desk"

# 32-byte hex key used to encrypt espn_s2/SWID inside the session cookie so they
# never sit in plaintext. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-64-hex-chars"

# Optional: email notifications (injury-status changes + waiver-wire digests).
# Without RESEND_API_KEY, notification UI shows "not configured" and no emails
# are ever sent — the rest of the app works normally. Get a key at resend.com;
# RESEND_FROM_EMAIL must be a domain verified in your Resend account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Gridiron Desk <notifications@yourdomain.com>"

# Optional: shared secret the waiver-digest cron endpoint checks for
# (Authorization: Bearer <value>). Generate with: openssl rand -hex 32
CRON_SECRET=""

# Optional: browser push notifications (same injury-status + waiver-wire
# events as email, delivered to a subscribed device instead of an inbox).
# Without these three, the push UI shows "not configured" and nothing is
# ever sent — the rest of the app works normally. Generate a real pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact ESPN's push providers can reach if they need to — a mailto: or
# https: URL, per the Web Push spec.
VAPID_SUBJECT="mailto:you@example.com"
